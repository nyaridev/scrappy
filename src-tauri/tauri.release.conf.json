{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/stage-host.mjs"
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/scrappy-host"],

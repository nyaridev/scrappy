{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrappy",
  "version": "1.0.0",
  "identifier": "com.nyaridev.scrappy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' scrappy: http://scrappy.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5RjQzOUQ3MEU0NTg4NjEKUldSaGlFVU8xem4wYVVTdUt4RjhldU52L3VpcHdVKzFJWFl0NlBvUk5WMXpEMTJ1dnJhcStablgK",
      "endpoints": ["https://github.com/nyaridev/scrappy/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
